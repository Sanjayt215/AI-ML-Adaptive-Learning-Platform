        "retained_mastery_gain": 0.40,
        "normalized_retained_gain": 0.533333,
        "exercise_efficiency": 0.05,
        "time_efficiency_per_min": 0.033333
      }
    },
    {
      "case_id": "TC-02-Ceiling-Effect",
