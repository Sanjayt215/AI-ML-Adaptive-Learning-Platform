{
  "project": "Knowledge-Tracing-Guided Reinforcement Learning for Personalized Exercise Selection",
  "version": "Phase 8 Evaluation Standard",
  "mastery_threshold": 0.80,
  "epsilon": 1e-6,
  "test_cases": [
    {
      "case_id": "TC-01-Standard-Improvement",
      "description": "Learner progresses from low prior knowledge to substantial mastery with minor retention decay",
      "inputs": {
        "p_pre": 0.25,
        "p_post": 0.75,
        "p_delayed": 0.65,
        "num_exercises": 10,
        "time_min": 15.0,
        "num_kcs": 1,
        "pre_mastered_kcs": 0,
        "post_mastered_kcs": 0
